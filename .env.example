# Copy to .env and fill in. .env is gitignored.

# Postgres + storage, project "agenda-ledger" (nvwllgwujqdwailnkels).
SUPABASE_URL=https://nvwllgwujqdwailnkels.supabase.co
# From the Supabase dashboard, Project Settings > API > service_role secret.
# Never the anon/publishable key -- this backend needs to write past RLS,
# and RLS is enabled with no public policies on every table on purpose.
SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 3: extraction and salience ---
ANTHROPIC_API_KEY=
# Pilot outlet: LAist. Verified live 2026-08-31: standard RSS 2.0, real
# title/link/description/pubDate per item, 12 items (a rolling "latest
# stories" feed, not a deep archive -- fine for a recency-windowed search).
OUTLET_RSS_FEED_URL=https://laist.com/rss/latest-news.rss
# Days before/after a meeting date to search GDELT/the outlet feed for mentions.
MENTIONS_WINDOW_DAYS=14
# Where Phase 2's receipt pages are deployed, e.g. https://receipts.example.com
# (no trailing slash). Used only to build receipt links in the Phase 3 report.
RECEIPTS_BASE_URL=

# --- Phase 4, not read by anything yet ---
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
NOTION_TOKEN=
